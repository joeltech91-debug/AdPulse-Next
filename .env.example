# AdPulse-Next — template uniquement. Ne jamais mettre les vraies valeurs ici.
# Copier dans .env.local (local) ou dans les variables du déploiement (Vercel).

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# MySQL existant — Prisma lit DATABASE_URL.
# Encoder les caractères spéciaux du mot de passe dans l'URL (%40 pour @, etc.).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_DATABASE"
# Paramètres séparés conservés pour faciliter la migration depuis l'API Go.
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# MakeTou / paiements — variables serveur uniquement.
# Vérifier si API_URL est la base API ou l'endpoint /stores/cart avant d'implémenter l'appel.
API_URL=
API_KEY=
MY_URL=http://localhost:3000
FRONT=http://localhost:3000
ID_PRODUIT=
ID_PRODUIT_19=c8dec53d-aac0-4d40-bd94-0574dcf99cbf
ID_PRODUIT_59=87b79ab6-ad20-4d6d-b219-6d8ab831ef6e

# Compatibilité temporaire avec l'ancien backend — confirmer l'usage avant migration.
COOKIE=
EMAIL=
# Ne pas définir une variable générique PASSWORD sans connaître son usage exact.

# Meta / Facebook — secret et callback uniquement côté serveur.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
NEXT_PUBLIC_META_APP_ID=

# Google OAuth — non présent dans le fichier de production fourni.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
