# AdPulse-Next — modèle uniquement. Ne jamais placer les vraies valeurs ici.
# Copier dans .env.local (local) ou dans les variables privées de l'hébergeur.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# MySQL existant : DATABASE_URL ou variables séparées.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_DATABASE"
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# MakeTou / paiement — serveur uniquement.
# Vérifier le format exact API_URL avec le fournisseur avant production.
API_URL=
API_KEY=
MY_URL=http://localhost:3000
FRONT=http://localhost:3000
# Identifiant du forfait 9 $ uniquement.
ID_PRODUIT=

# Google Identity Services
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta OAuth — vérifier les identifiants et l'URL de callback.
META_APP_ID=1083363634373087
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
NEXT_PUBLIC_META_APP_ID=1083363634373087
NEXT_PUBLIC_META_CONFIG_ID=1638883141127442

# Variables legacy : ne pas les réutiliser sans vérifier leur fonction.
COOKIE=
EMAIL=
